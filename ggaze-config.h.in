#ifndef GGAZE_CONFIG_H
#define GGAZE_CONFIG_H

/* Generated by meson from ggaze-config.h.in — do not edit the build copy. */

#define GGAZE_VERSION @GGAZE_VERSION@
#define GGAZE_APP_ID  @GGAZE_APP_ID@

/* Optional backends (1 = compiled in, 0 = absent). */
#define GGAZE_HAVE_GEGL @GGAZE_HAVE_GEGL@
#define GGAZE_HAVE_JXL  @GGAZE_HAVE_JXL@
#define GGAZE_HAVE_AVIF @GGAZE_HAVE_AVIF@
#define GGAZE_HAVE_HEIF @GGAZE_HAVE_HEIF@
#define GGAZE_HAVE_JPEG @GGAZE_HAVE_JPEG@

/* 1 when at least one format-specific loader backend (JXL/AVIF/HEIF/JPEG)
 * is compiled in, 0 in the minimal build where the GdkPixbuf fallback is
 * the only decoder. Derived here rather than set by meson so it can never
 * disagree with the four flags above. loader.c compiles the backend table
 * and every path only a claiming backend can take under it, so the minimal
 * build (the CI lane whose coverage is gated) carries no unreachable code. */
#define GGAZE_HAVE_ANY_BACKEND                                                 \
   (GGAZE_HAVE_JXL || GGAZE_HAVE_AVIF || GGAZE_HAVE_HEIF || GGAZE_HAVE_JPEG)

#endif /* GGAZE_CONFIG_H */